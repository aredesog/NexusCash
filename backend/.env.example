# Copie para ".env" (mesma pasta) e preencha. O .env está no .gitignore.

# Chave grátis Demo: https://www.coingecko.com/en/developers/dashboard
COINGECKO_API_KEY=

# ids da CoinGecko separados por vírgula
COINS=bitcoin,ethereum,solana,binancecoin,ripple,cardano,dogecoin,tron,avalanche-2,chainlink,polkadot,litecoin

# intervalo de atualização em segundos (mínimo 30)
REFRESH_SECONDS=60
